* {
  background-color: transparent; 
}

configuration {
  modi: "drun,window";
  display-drun: "> ";
  drun-display-format: "{name}";
  show-icons: true;
  display-window: "Windows:";
  window-format: "{w} {c}";
}

window {
  fullscreen: true;
  background-color: rgba(36, 39, 58, 0.7);
  transparency: "real";
  anchor: "center";
  x-offset: 0px;
  y-offset: 0px;

  enabled: true;
  margin: 0px;
  padding: 0px;
  border: 0px solid;
  border-radius: 0px;
  border-color: Red;
  cursor: "default";
  padding: 50px 10px 50px 10px;
}

mainbox {
  enabled: true;
  children: [inputbar, listview];
  padding: 0px 200px;
  background-color: transparent;
}

inputbar {
  enabled: true;
  background-color: transparent;
  children: ["entry"];
}

entry {
  enabled: true;
  border-radius: 20px;
  vertical-align: 0.5;
  font: "SF Pro Display Bold 15";
  placeholder: "    Search";
  padding: 15px 20px;
  margin: 10px 550px;
  background-color: rgba(202, 211, 245, 0.1);
  color: #cad3f5;
}

listview {
  layout: vertical;
  fixed-height: true;
  columns: 5;
  lines: 5;
  padding: 50px 120px;
}

element {
  enabled: true;
  children: [element-icon, element-text];
  orientation: vertical;
  margin: 15px 20px;
  padding: 10px 10px;
  border-radius: 20px;
}

element selected.normal {
  background-color: rgba(202, 211, 245, 0.2);
}

element-text {
  horizontal-align: 0.5;
  font: "SF Pro Display Regular 15";
  color: #cad3f5;
}

element-icon {
  size: 100px;
  horizontal-align: 0.5;
}
