* {
  background-color: transparent;
  font: "SF Pro Display Bold 12";
}

configuration {
  modi: "drun,window";
  display-drun: "> ";
  drun-display-format: "{name}";
  show-icons: true;
  display-window: "Windows:";
  window-format: "{w} {c}";
}

window {
  background-color: transparent;
  padding: 10px;
  width: 500px;
}


inputbar {
  enabled: true; 
  background-color: transparent;
  children: ["textbox-prompt-colon", "entry"];
}

textbox-prompt-colon {
  enabled: true;
  str: "";
  font: "CaskaydiaCove Nerd Font Bold 25";
  text-color: #8aadf4;
  width: 75px;
  background-color: #24273a;
  margin: 10px 10px 10px 3px;
  expand: false;
  border-radius: 15px;
  horizontal-align: 0.2;
  vertical-align: 0.5;
  padding: 10px 10px;
  border: 1;
  border-color: #8aadf4;
}

entry {
  expand: false;
  width: 400px;
  font: "SF Pro Display Bold 20";
  vertical-align: 0.5;
  background-color: #24273a;
  border-radius: 15px;
  margin: 10px 0px;
  padding: 0px 20px;
  color: #cad3f5;
  border: 1;
  border-color: #8aadf4;
}

listview {
  layout: vertical;
  columns: 1;
  fixed-height: true;
  fixed-columns: true;
  spacing: 10px;
  lines: 5;
  background-color: #24273a;
  border-radius: 20px;
  padding: 10px;
  color: #cad3f5;
  width: 100px;
  spacing: 10px;
  cycle: true;
  dynamic: true;
  padding: 20px 10px;
  border: 1;
  border-color: #8aadf4;
}

element {
  enabled: true;
  padding: 10px 10px;
  margin: 0px 10px;
  border-radius: 15px;
  cursor: pointer;
  children: [element-icon, element-text];
}

element selected.normal {
  background-color: #363a4f;
}

element-text {
  font: "SF Pro Display Bold 15";
  vertical-align: 0.5;
  padding: 10px 10px;
  color: #cad3f5;
}

element-icon {
  size: 40px;
}

