{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/logo.txt",
    "color": {
      "1": "blue",
      "2": "red"
    }
  },
  "display": {},
  "modules": [
    {
      "type": "custom",
      "format": "╭───  user ──────────────────────────────────────────╮",
      "outputColor": "blue"
    },
    {
      "type": "command",
      "text": "printf '   %s@%s                                  ' \"$USER\" \"$(hostname)\"",
      "key": " ",
      "outputColor": "blue"
    },
    {
      "type": "custom",
      "format": "╰─────────────────────────────────────────────────────╯",
      "outputColor": "blue"
    },
    {
      "type": "custom",
      "format": "╭─── 󰇅 System ────────────────────────────────────────╮",
      "outputColor": "red"
    },
    {
      "type": "host",
      "format": "     Machine     {name}        ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "cpu",
      "format": "     CPU         {name} {march}         ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "gpu",
      "format": "     GPU         {vendor} {name} {type}              ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "memory",
      "format": "     RAM         {used}/{total} ({percentage})            ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "disk",
      "format": "     Storage     {size-used}/{size-total} ({size-percentage}) - {filesystem}   ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "os",
      "format": "   󰣇  Distro      {name} {arch}                   ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "kernel",
      "format": "     Kernel      {sysname} {release}                ",
      "key": " ",
      "outputColor": "red"
    },
    {
      "type": "custom",
      "format": "╰─────────────────────────────────────────────────────╯",
      "outputColor": "red"
    },
    {
      "type": "custom",
      "format": "╭───   Environment ──────────────────────────────────╮",
      "outputColor": "magenta"
    },
    {
      "type": "wm",
      "format": "   󰣆  DE          {pretty-name} {version}                     ",
      "key": " ",
      "outputColor": "magenta"
    },
    {
      "type": "shell",
      "format": "     Shell       {pretty-name} {version}                             ",
      "key": " ",
      "outputColor": "magenta"
    },
    {
      "type": "terminal",
      "format": "     Terminal    {pretty-name} {version}                 ",
      "key": " ",
      "outputColor": "magenta"
    },
    {
      "type": "packages",
      "format": "     Packages    Pacman - {pacman}                        ",
      "key": " ",
      "outputColor": "magenta"
    },
    {
      "type": "datetime",
      "format": "   󱑎  Date&Time   {month-name} {day-in-month} {year}, {hour-pretty}:{minute-pretty} {timezone-name} ",
      "key": " ",
      "outputColor": "magenta"
    },
    {
      "type": "custom",
      "format": "╰─────────────────────────────────────────────────────╯",
      "outputColor": "magenta"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 10
    }
  ]
}
